{
  "name": "holidayvote",
  "version": "1.0.0",
  "private": true,
  "description": "HolidayVote – choose the holiday home together",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap run ios",
    "ios:open": "npm run sync && cap open ios",
    "android": "npm run sync && cap run android",
    "android:open": "npm run sync && cap open android",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=./screenshots playwright test screenshots",
    "build:dev": "vite build --mode development",
    "android:dev": "bash scripts/android-install.sh",
    "android:install": "bash scripts/android-install.sh",
    "supabase:bundle": "node scripts/bundle-supabase-sql.mjs",
    "supabase:setup": "bash scripts/setup-supabase.sh",
    "release:test": "bash scripts/release-test.sh",
    "screenshots:store": "STORE_SCREENSHOTS=1 playwright test store-screenshots --workers=2",
    "assets:icons": "node assets/src/render.mjs && npx capacitor-assets generate --ios --android --iconBackgroundColor '#0e7c86' --iconBackgroundColorDark '#0b3d44' --splashBackgroundColor '#f4efe6' --splashBackgroundColorDark '#10181a'"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "8.0.3",
    "@ionic/react": "9.0.10",
    "@ionic/react-router": "9.0.10",
    "@supabase/supabase-js": "2.119.0",
    "date-fns": "4.4.0",
    "i18next": "27.0.0",
    "ionicons": "8.1.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.0",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "sql.js": "1.15.2",
    "supabase": "3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
