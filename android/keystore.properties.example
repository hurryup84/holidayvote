# Copy to <apps>/android_signing/keystore.properties.holidayvote (or keystore.properties), next to the
# keystore file, OUTSIDE this repo, and fill in.
# Used by android/app/build.gradle for release builds (fastlane android build / internal).
# storeFile is relative to this properties file.
#
# Either reuse the shared upload key (same values as keystore.properties.dining_table):
#   storeFile=key.jks + its alias and passwords
# or create a separate upload key for HolidayVote:
#   keytool -genkeypair -v -keystore holidayvote.jks -alias holidayvote -keyalg RSA -keysize 2048 -validity 10000
#   storeFile=holidayvote.jks, keyAlias=holidayvote
# Whichever key signs the first upload becomes HolidayVote's upload key on Google Play (Play App Signing) –
# back it up together with its passwords.
storeFile=key.jks
storePassword=
keyAlias=
keyPassword=
